# Copy to .env and fill in your own key. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small
# Point to an independently built ns-3 source tree.
NS3_DIR=./ns-3.46.1
NS3_TIMEOUT=300
DOCUMENTS_DIR=./documents
VECTOR_DB_DIR=./ns3_vector_db
OUTPUT_DIR=./outputs
